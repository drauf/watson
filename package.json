    "@vitest/coverage-v8": "4.1.10",
    "browserslist": "4.28.6",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.1.1",
    "jsdom": "29.1.1",
    "node-gyp": "11.4.2",
    "rollup": "4.62.2",
    "stylelint": "15.10.3",
    "stylelint-config-rational-order": "0.1.2",
    "stylelint-config-standard": "34.0.0",
    "stylelint-order": "6.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.3",
    "vite-tsconfig-paths": "4.2.0",
    "vitest": "4.1.10"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -p tsconfig.prod.json && vite build",
    "serve": "vite preview",
    "lint-types": "tsc --noEmit",
    "lint-prod": "eslint --fix 'src/**/*.{ts,tsx}' && stylelint --fix 'src/**/*.css'",
    "lint-test": "eslint --fix 'e2e/**/*.{ts,tsx}' 'playwright/**/*.{ts,tsx}' && stylelint --fix 'e2e/**/*.css' --allow-empty-input",
    "lint": "yarn lint-types && yarn lint-prod && yarn lint-test",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --watch=false",
    "test:e2e": "playwright test",
    "predeploy": "yarn build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 edge versions",
    "last 2 firefox versions",
    "last 2 safari versions"
  ],
  "packageManager": "yarn@4.17.0"
}
