{
  "name": "watson",
  "version": "0.1.0",
  "description": "Watson is a web-based, offline Java thread dump analyzer",
  "author": "Daniel Rauf <danielrauf@gmail.com> (https://github.com/drauf/)",
  "license": "MIT",
  "homepage": "https://drauf.github.io/watson/",
  "repository": {
    "type": "git",
    "url": "https://github.com/drauf/watson.git"
  },
  "bugs": {
    "url": "https://github.com/drauf/watson/issues"
  },
  "dependencies": {
    "@atlaskit/app-provider": "5.4.0",
    "@atlaskit/button": "25.2.0",
    "@atlaskit/css-reset": "8.3.1",
    "@atlaskit/dropdown-menu": "18.2.0",
    "@atlaskit/empty-state": "12.1.0",
    "@atlaskit/form": "17.1.0",
    "@atlaskit/heading": "7.1.0",
    "@atlaskit/icon": "37.5.0",
    "@atlaskit/lozenge": "15.3.0",
    "@atlaskit/pagination": "17.2.0",
    "@atlaskit/popup": "6.2.0",
    "@atlaskit/primitives": "22.4.0",
    "@atlaskit/progress-bar": "5.2.0",
    "@atlaskit/textfield": "10.1.0",
    "@atlaskit/tokens": "16.8.0",
    "@compiled/react": "1.0.2",
    "@tanstack/react-virtual": "3.14.10",
    "fflate": "0.8.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-dropzone": "20.1.1",
    "react-is": "19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@atlaskit/platform-feature-flags": "2.1.1",
    "@atlaskit/stylelint-design-system": "5.0.2",
    "@babel/core": "8.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "8.68.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "browserslist": "4.28.8",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.2.0",
    "fake-indexeddb": "6.2.5",
    "jsdom": "30.0.1",
    "node-gyp": "13.0.1",
    "oxc-transform-react": "0.147.0",
    "rollup": "4.62.5",
    "stylelint": "17.14.1",
    "stylelint-config-recess-order": "7.8.0",
    "stylelint-config-standard": "40.0.0",
    "stylelint-order": "8.1.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.11"
  },
  "scripts": {
    "start": "vite",
    "tsc7": "node ./node_modules/@typescript/native/bin/tsc",
    "build": "yarn tsc7 -p tsconfig.prod.json && vite build",
    "serve": "vite preview",
    "lint-types": "yarn tsc7 --noEmit",
    "lint-prod": "eslint --fix 'src/**/*.{ts,tsx}' && stylelint --fix 'src/**/*.css'",
    "lint-test": "eslint --fix 'e2e/**/*.{ts,tsx}' 'playwright/**/*.{ts,tsx}' && stylelint --fix 'e2e/**/*.css' --allow-empty-input",
    "lint": "yarn lint-types && yarn lint-prod && yarn lint-test",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --watch=false",
    "test:e2e": "playwright test",
    "predeploy": "yarn build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 edge versions",
    "last 2 firefox versions",
    "last 2 safari versions"
  ],
  "packageManager": "yarn@4.18.0"
}
