{
  "name": "watson",
  "version": "0.1.0",
  "description": "Watson is a web-based, offline Java thread dump analyzer",
  "author": "Daniel Rauf <danielrauf@gmail.com> (https://github.com/drauf/)",
  "license": "MIT",
  "homepage": "https://drauf.github.io/watson/",
  "repository": {
    "type": "git",
    "url": "https://github.com/drauf/watson.git"
  },
  "bugs": {
    "url": "https://github.com/drauf/watson/issues"
  },
  "dependencies": {
    "@atlaskit/css-reset": "7.3.8",
    "@atlaskit/tokens": "7.0.0",
    "d3": "7.9.0",
    "d3-flame-graph": "5.0.0",
    "flatted": "3.4.3",
    "jszip": "3.10.1",
    "localforage": "1.10.0",
    "react": "18.2.0",
    "react-app-polyfill": "3.0.0",
    "react-dom": "18.2.0",
    "react-dropzone": "14.2.3",
    "react-is": "18.3.1",
    "react-new-window": "^1.0.1",
    "react-router-dom": "6.15.0",
    "recharts": "3.9.2",
    "spark-md5": "3.0.2"
  },
  "devDependencies": {
    "@atlaskit/stylelint-design-system": "4.1.3",
    "@babel/core": "7.29.7",
    "@playwright/test": "1.62.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "14.0.0",
    "@types/d3": "7.4.3",
    "@types/node": "24.4.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.2.7",
    "@types/react-router-dom": "5.3.3",
    "@types/spark-md5": "3.0.5",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react-swc": "3.11.0",
    "@vitest/coverage-v8": "4.1.10",
    "browserslist": "4.28.6",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.1.1",
    "jsdom": "29.1.1",
    "node-gyp": "11.4.2",
    "rollup": "4.62.2",
    "stylelint": "15.10.3",
    "stylelint-config-rational-order": "0.1.2",
    "stylelint-config-standard": "34.0.0",
    "stylelint-order": "6.0.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.3",
    "vite-tsconfig-paths": "4.2.0",
    "vitest": "4.1.10"
  },
  "scripts": {
    "start": "vite",
    "build": "tsc -p tsconfig.prod.json && vite build",
    "serve": "vite preview",
    "lint-types": "tsc --noEmit",
    "lint-prod": "eslint --fix 'src/**/*.{ts,tsx}' && stylelint --fix 'src/**/*.css'",
    "lint-test": "eslint --fix 'e2e/**/*.{ts,tsx}' && stylelint --fix 'e2e/**/*.css' --allow-empty-input",
    "lint": "yarn lint-types && yarn lint-prod && yarn lint-test",
    "test": "vitest",
    "test:coverage": "vitest run --coverage --watch=false",
    "test:e2e": "playwright test",
    "predeploy": "yarn build"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 edge versions",
    "last 2 firefox versions",
    "last 2 safari versions"
  ],
  "packageManager": "yarn@4.17.0"
}
