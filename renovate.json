{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Container registries do not expose release timestamps, so do not treat image updates as permanently pending",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "groupName": "Playwright",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ]
    },
    {
      "extends": [
        "packages:atlaskit"
      ],
      "groupName": "Atlaskit dependencies"
    },
    {
      "groupName": "React",
      "matchPackageNames": [
        "react",
        "react-dom",
        "react-is",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "groupName": "Vite build tooling",
      "matchPackageNames": [
        "vite",
        "@vitejs/plugin-react",
        "rollup",
        "vite-plugin-singlefile"
      ]
    },
    {
      "groupName": "Testing utilities",
      "matchPackageNames": [
        "@testing-library/dom",
        "@testing-library/jest-dom",
        "@testing-library/react",
        "fake-indexeddb",
        "jsdom"
      ]
    },
    {
      "description": "Automerge non-major updates after required checks pass",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    }
  ],
  "schedule": [
    "* * * * 2"
  ],
  "prConcurrentLimit": 20,
  "prCreation": "not-pending",
  "prHourlyLimit": 10
}
