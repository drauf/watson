{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "packageRules": [
    {
      "description": "Container registries do not expose release timestamps, so do not treat image updates as permanently pending",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "groupName": "Playwright",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ]
    },
    {
      "extends": [
        "packages:atlaskit"
      ],
      "groupName": "Atlaskit dependencies"
    }
  ],
  "prConcurrentLimit": 20,
  "prCreation": "not-pending",
  "prHourlyLimit": 10
}
