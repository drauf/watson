{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Container registries do not expose release timestamps, so do not treat image updates as permanently pending",
      "matchDatasources": [
        "docker"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "groupName": "CI and tooling",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest",
        "pinDigest"
      ],
      "automerge": true
    },
    {
      "groupName": "npm dependencies",
      "matchDatasources": [
        "npm"
      ]
    },
    {
      "groupName": "Playwright",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ]
    },
    {
      "description": "Keep major updates separate and require manual merging",
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "automerge": false
    }
  ],
  "prConcurrentLimit": 20,
  "prHourlyLimit": 10
}
