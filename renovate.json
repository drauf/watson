{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "packageRules": [
    {
      "groupName": "Playwright",
      "matchPackageNames": [
        "@playwright/test",
        "mcr.microsoft.com/playwright"
      ]
    }
  ]
}
